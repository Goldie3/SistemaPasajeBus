# Servidor
PORT=4000
NODE_ENV=development

# Motor de base de datos: postgres (exigido por la pauta) o mysql
DB_DIALECT=postgres

# Postgres local (ejemplo)
DATABASE_URL=postgres://usuario:password@localhost:5432/nombre_base_datos

DB_USER=usuario
DB_PASSWORD=password
DB_NAME=nombre_base_datos
DB_HOST=localhost
DB_PORT=5432

# Si en vez de Postgres usas MySQL localmente, cambia DB_DIALECT=mysql
# y usa el formato: DATABASE_URL=mysql://usuario:password@localhost:3306/nombre_base_datos
# JWT
JWT_SECRET=tu_secreto_jwt
JWT_ACCESS_SECRET=tu_access_secret_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=tu_refresh_secret_de_al_menos_32_caracteres

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

#conexion produccion (Railway - PostgreSQL)
# Al agregar el plugin de PostgreSQL en Railway, estas variables
# se generan automáticamente y quedan disponibles como referencia.
DATABASE_URL="${{Postgres.DATABASE_URL}}"
PGHOST="${{Postgres.PGHOST}}"
PGPORT="${{Postgres.PGPORT}}"
PGUSER="${{Postgres.PGUSER}}"
PGPASSWORD="${{Postgres.PGPASSWORD}}"
PGDATABASE="${{Postgres.PGDATABASE}}"

# Frontend
FRONTEND_URL=http://localhost:3000