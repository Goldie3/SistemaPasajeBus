# URL de conexión completa a MySQL.
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
# Local:      mysql://root:1234@localhost:3306/sistemapasajebus
# Producción: lo entrega Railway automáticamente al conectar el plugin MySQL.
DATABASE_URL=mysql://root:CONTRASEÑA@localhost:3306/sistemapasajebus
 
 
# Clave secreta para firmar los tokens JWT.
# Usa cualquier texto largo y aleatorio (mínimo 32 caracteres).
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En producción configúralo en el panel de Railway, nunca lo dejes por defecto.
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio
 
 
 
# Puerto en el que escucha la API.
# Railway inyecta este valor automáticamente en producción; no lo cambies allá.
PORT=3000
 
# Entorno de ejecución. Valores válidos: development | test | production
# Controla el nivel de logging de Sequelize y otros comportamientos.
NODE_ENV=development
 